{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fish POS",
  "version": "0.3.4",
  "identifier": "com.fishshop.pos",
  "build": {
    "beforeDevCommand": "vite --mode fish",
    "beforeBuildCommand": "tsc --noEmit -p tsconfig.fish.json && vite build --mode fish"
  },
  "app": {
    "windows": [
      {
        "title": "نقطة بيع الأسماك",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ahmedgamalalzatary/fish_desktop/releases/download/fish-updates/latest.json"
      ]
    }
  }
}
