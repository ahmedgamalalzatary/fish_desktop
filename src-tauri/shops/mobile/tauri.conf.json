{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobile POS",
  "version": "0.5.4",
  "identifier": "com.mobileshop.pos",
  "build": {
    "beforeDevCommand": "vite --mode mobile",
    "beforeBuildCommand": "tsc --noEmit -p tsconfig.mobile.json && vite build --mode mobile"
  },
  "app": {
    "windows": [
      {
        "title": "نقطة بيع الموبايلات",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ahmedgamalalzatary/fish_desktop/releases/download/mobile-updates/latest.json"
      ]
    }
  }
}
