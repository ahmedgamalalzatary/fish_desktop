{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS",
  "version": "0.0.0",
  "identifier": "com.pos.template",
  "build": {
    "beforeDevCommand": "echo Pick a shop, e.g. npm run dev mobile && exit 1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "echo Pick a shop, e.g. npm run build mobile && exit 1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "نقطة البيع",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQjVBOTQ2OTRBMDRDNEIKUldSTFRLQ1VScW0xVW56cG5IZWlpQVBvQXVsenN4Q1lyR1dOdDZ6UW1BY2g2RkZ0UkVONnpDMGcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
