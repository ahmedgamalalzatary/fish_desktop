{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:fish": "tauri dev --config src-tauri/shops/fish/tauri.conf.json --features fish",
    "dev:mobile": "tauri dev --config src-tauri/shops/mobile/tauri.conf.json --features mobile",
    "build:fish": "tauri build --config src-tauri/shops/fish/tauri.conf.json --features fish",
    "build:mobile": "tauri build --config src-tauri/shops/mobile/tauri.conf.json --features mobile",
    "dev:web": "vite",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.fish.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && npm run clippy:fish && npm run clippy:mobile",
    "clippy:fish": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features fish -- -D warnings",
    "clippy:mobile": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features mobile -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "npm run test:fish && npm run test:mobile",
    "test:fish": "vitest run --mode fish && cargo test --manifest-path src-tauri/Cargo.toml --features fish",
    "test:mobile": "vitest run --mode mobile && cargo test --manifest-path src-tauri/Cargo.toml --features mobile",
    "test:watch": "vitest --mode mobile",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
