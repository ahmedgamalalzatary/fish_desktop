{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": { "@shop": ["./src/shops/fish"], "@shop/*": ["./src/shops/fish/*"] }
  },
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/components",
    "src/lib",
    "src/pages",
    "src/shops/fish",
    "tests/*.ts",
    "tests/fish"
  ],
  "exclude": ["tests/shops.test.ts"]
}
